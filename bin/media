#!/usr/bin/env python3
"""Make the README's pictures: docs/screenshot-light.png, docs/screenshot-dark.png and
docs/demo.gif.

It fills a throwaway database with made-up questions for three invented projects, runs the
page from this checkout on a free port, and drives headless Google Chrome through the Chrome
DevTools Protocol (CDP, the commands Chrome takes over a pipe), so the pictures come out the
same way every time. Your own questions are never touched.

Needs Python 3.9 or newer, Google Chrome, and ffmpeg (`brew install ffmpeg`), which turns
the recorded frames into the GIF. Set CHROME to the browser's path if it isn't installed in
/Applications.

    bin/media              # all three files
    bin/media --keep DIR   # also keep the database, the frames and the server log in DIR
"""

from __future__ import annotations

import argparse
import base64
import contextlib
import fcntl
import json
import os
import shutil
import socket
import sqlite3
import subprocess  # nosec B404
import sys
import tempfile
import time
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DOCS = ROOT / "docs"
CHROME_APP = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# The real page's ports; the demo never uses them.
RESERVED_PORTS = {2204, 2205}
WIDTH, HEIGHT = 1280, 800
GIF_WIDTH = 1040
GIF_LIMIT = 1_000_000
STAMP = "%Y-%m-%dT%H:%M:%SZ"

# The demo questions. "age" is how many hours ago each was asked, so the list shows a mix.
ORDERS = "Orders export"
CHECKOUT = "Checkout v2"
