#!/usr/bin/env python3
"""Check that plugin.json and pyproject.toml carry the same version, and print it.

bin/ci runs this so a pull request cannot raise one file and forget the other, or forget the
version's CHANGELOG.md section. The release workflow uses the printed version to name the tag.
"""

import json
import re
import sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent


def read(name: str) -> str:
    return (root / name).read_text(encoding="utf-8")


plugin = json.loads(read(".claude-plugin/plugin.json"))["version"]
match = re.search(r'^version = "([^"]+)"', read("pyproject.toml"), re.M)
project = match.group(1) if match else None

if plugin != project:
    sys.exit(
        "Version mismatch: .claude-plugin/plugin.json says %s but pyproject.toml says %s. "
        "Set the same version in both." % (plugin, project)
    )
if not re.search(r"^## \[%s\]" % re.escape(plugin), read("CHANGELOG.md"), re.M):
    sys.exit("CHANGELOG.md has no '## [%s]' section. Add one for this version." % plugin)
print(plugin)
